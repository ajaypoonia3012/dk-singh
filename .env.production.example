# DK Singh Fitness & Nutrition — Production Environment Template
# NEVER commit the actual .env file or production secret keys to version control.

APP_NAME="DK Singh Fitness & Nutrition"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://dksinghfitness.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=cache
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_LEVEL=error

# Production Database (MySQL / MariaDB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dk_singh_fitness_prod
DB_USERNAME=dksingh_prod_user
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE

# Production Session & Cache Management
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=dksinghfitness.com
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

# Filesystem & Storage
FILESYSTEM_DISK=public

# Mail Configuration (SMTP / Postmark / Sendgrid / SES)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=YOUR_SMTP_USERNAME_HERE
MAIL_PASSWORD=YOUR_SMTP_PASSWORD_HERE
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="info@dksinghfitness.com"
MAIL_FROM_NAME="DK Singh Fitness & Nutrition"

# Payment Gateways (Razorpay & Stripe)
RAZORPAY_KEY_ID=YOUR_RAZORPAY_LIVE_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_LIVE_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

STRIPE_KEY=YOUR_STRIPE_LIVE_PUBLIC_KEY
STRIPE_SECRET=YOUR_STRIPE_LIVE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET

# AWS S3 (Optional if using cloud storage disk)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Vite Public Environment
VITE_APP_NAME="${APP_NAME}"
