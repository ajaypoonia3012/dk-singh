public function moveTransformationUp($id)
{
    $item = Transformation::find($id);

    if (!$item) {
        return;
    }

    $previous = Transformation::where(
        'sort_order',
        '<',
        $item->sort_order
    )
    ->orderByDesc('sort_order')
    ->first();

    if (!$previous) {
        return;
    }

    [$item->sort_order, $previous->sort_order] = [
        $previous->sort_order,
        $item->sort_order,
    ];

    $item->save();

    $previous->save();

    $this->transformations = Transformation::orderBy('sort_order')->get();

    $this->loadTransformation($item->id);
}

public function moveTransformationDown($id)
{
    $item = Transformation::find($id);

    if (!$item) {
        return;
    }

    $next = Transformation::where(
        'sort_order',
        '>',
        $item->sort_order
    )
    ->orderBy('sort_order')
    ->first();

    if (!$next) {
        return;
    }

    [$item->sort_order, $next->sort_order] = [
