    public function mount()
    {
        $builder = new BuilderState();

        $this->setting = Setting::first();


$this->contact = [

    'contact_title'       => $this->setting->contact_title,
    'contact_heading'     => $this->setting->contact_heading,
    'contact_description' => $this->setting->contact_description,

    'map_embed_url'       => $this->setting->map_embed_url,
    'map_link'            => $this->setting->map_link,
    'contact_map_text'    => $this->setting->contact_map_text,

];

        /*
|--------------------------------------------------------------------------
| Hero
|--------------------------------------------------------------------------
*/

$hero = (new HeroService())->get();

$this->hero = [

    'heading' => $hero->heading,

    'subheading' => $hero->subheading,

    'button_text' => $hero->button_text,

    'button_link' => $hero->button_link,

    'view_button_text' => $hero->view_button_text,

    'view_button_link' => $hero->view_button_link,

];

$this->heroBackgroundMediaId = $hero->background_media_id;

        $this->heroBackgroundOptions = \App\Models\Media::query()
            ->latest()
            ->get();


        $this->homepageCards = HomepageCard::orderBy('sort_order')->get();

if ($this->homepageCards->count()) {
    $this->loadHomepageCard(
        $this->homepageCards->first()->id
    );
}

$this->programs = Program::orderBy('sort_order')->get();

if ($this->programs->count()) {
    $this->loadProgram(
        $this->programs->first()->id
    );
}

$this->products = Product::orderBy('sort_order')->get();

if ($this->products->count()) {

    $this->loadProduct(
        $this->products->first()->id
    );

}

$this->transformations = Transformation::orderBy('sort_order')->get();

if ($this->transformations->count()) {

    $this->loadTransformation(
        $this->transformations->first()->id
    );

}



$this->testimonials = Testimonial::orderBy('sort_order')->get();

if ($this->testimonials->count()) {

    $this->loadTestimonial(
        $this->testimonials->first()->id
    );

}


$this->blogs = Blog::orderBy('sort_order')->get();

if ($this->blogs->count()) {

    $this->loadBlog(
        $this->blogs->first()->id
    );

}



        $this->sections = WebsiteSection::orderBy('sort_order')->get();

        $this->selectedSection = $this->sections->first();
    }

    /*
    |--------------------------------------------------------------------------
    | Homepage Card
    |--------------------------------------------------------------------------
    */

    public function loadHomepageCard($id)
    {
        $card = HomepageCard::findOrFail($id);

        $this->selectedHomepageCardId = $card->id;

        $this->homepageCard = $card->toArray();
    }

    public function selectHomepageCard($id)
    {
        $this->loadHomepageCard($id);
    }

    public function saveHomepageCard()
    {
        $card = HomepageCard::findOrFail(
            $this->selectedHomepageCardId
        );

        /*
        |--------------------------------------------------------------------------
        | Upload Image
        |--------------------------------------------------------------------------
        */

        if ($this->homepageCardImage) {

            $path = $this->homepageCardImage->store(
                'homepage-cards',
                'public'
            );

            $this->homepageCard['background_image'] = $path;
        }

        /*
        |--------------------------------------------------------------------------
        | Save Card
        |--------------------------------------------------------------------------
        */

        $card->update($this->homepageCard);

        /*
        |--------------------------------------------------------------------------
        | Refresh Builder
        |--------------------------------------------------------------------------
        */

        $this->homepageCards = HomepageCard::orderBy('sort_order')->get();

        $this->loadHomepageCard($card->id);

        $this->homepageCardImage = null;

        $this->dispatch(
            'notify',
            title: 'Homepage Card Saved'
        );
    }




public function openMediaPicker(string $target, ?int $recordId = null)
{
    $this->mediaTarget = $target;

    $this->mediaRecordId = $recordId;

    $this->showMediaPicker = true;
}

public function closeMediaPicker()
{
    $this->showMediaPicker = false;

    $this->mediaTarget = null;

    $this->mediaRecordId = null;
}

#[On('media-selected')]
public function mediaSelected($id)
{
    switch ($this->mediaTarget) {

        case 'hero':
            $this->heroBackgroundMediaId = $id;
            break;

        case 'homepage-card':
            $this->homepageCardBackgroundMediaId = $id;

            if ($this->selectedHomepageCardId) {
                $this->homepageCard['background_media_id'] = $id;
            }

            break;
    }

    $this->showMediaPicker = false;

    $this->mediaTarget = null;

    $this->mediaRecordId = null;
}

public function deleteHeroImage()
{
    if (
        $this->setting->hero_image &&
        Storage::disk('public')->exists(
            $this->setting->hero_image
        )
    ) {
        Storage::disk('public')->delete(
            $this->setting->hero_image
        );
    }

    $this->setting->update([

        'hero_image' => null,

    ]);

    $this->setting = Setting::first();

    $this->dispatch(
        'notify',
        title: 'Hero Image Deleted'
    );
}


    /*
    |--------------------------------------------------------------------------
    | Homepage Card Ordering
    |--------------------------------------------------------------------------
    */

    public function moveHomepageCardUp($id)
    {
        $card = HomepageCard::find($id);

        if (!$card) {
            return;
        }

        $previous = HomepageCard::where(
            'sort_order',
            '<',
            $card->sort_order
        )
        ->orderByDesc('sort_order')
        ->first();

        if (!$previous) {
            return;
        }

        [$card->sort_order, $previous->sort_order] = [
            $previous->sort_order,
            $card->sort_order,
        ];

        $card->save();

        $previous->save();

        $this->homepageCards =
            HomepageCard::orderBy('sort_order')->get();
    }

    public function moveHomepageCardDown($id)
    {
        $card = HomepageCard::find($id);

        if (!$card) {
            return;
        }

        $next = HomepageCard::where(
            'sort_order',
            '>',
            $card->sort_order
        )
        ->orderBy('sort_order')
        ->first();

        if (!$next) {
            return;
        }

        [$card->sort_order, $next->sort_order] = [
            $next->sort_order,
            $card->sort_order,
        ];

        $card->save();

        $next->save();

        $this->homepageCards =
            HomepageCard::orderBy('sort_order')->get();
    }


