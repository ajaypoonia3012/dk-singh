  /*
|--------------------------------------------------------------------------
| Hero
|--------------------------------------------------------------------------
*/

public function saveHero()
{
    $this->validate([

        'hero.heading' => 'required|string|max:255',

        'hero.subheading' => 'nullable|string',

        'hero.button_text' => 'nullable|string|max:255',

        'hero.button_link' => 'nullable|string|max:255',

        'hero.view_button_text' => 'nullable|string|max:255',

        'hero.view_button_link' => 'nullable|string|max:255',

    ]);

    /*
    |--------------------------------------------------------------------------
    | Upload Hero Image
    |--------------------------------------------------------------------------
    */

   
if ($this->heroImage) {


        $manager = new ImageManager(new Driver());


        $image = $manager->read(
            $this->heroImage->getRealPath()
        );

        $image->scaleDown(width: 1600);

        $filename = uniqid('hero_') . '.webp';

        $path = storage_path(
            'app/public/settings/' . $filename
        );

        $image->toWebp(82)->save($path);

        if (
            $this->setting->hero_image &&
            Storage::disk('public')->exists(
                $this->setting->hero_image
            )
        ) {
            Storage::disk('public')->delete(
                $this->setting->hero_image
            );
        }

        
    $this->setting->update([

        'hero_image' =>
            'settings/' . $filename,

    ]);

    

    $this->heroImage = null;

}

    (new HeroService())->update([



    'heading' => $this->hero['heading'],



    'subheading' => $this->hero['subheading'],



    'button_text' => $this->hero['button_text'],



    'button_link' => $this->hero['button_link'],



    'view_button_text' => $this->hero['view_button_text'],



    'view_button_link' => $this->hero['view_button_link'],

    'background_media_id' => $this->heroBackgroundMediaId,




]);

$this->setting = Setting::first();
$this->hero = (new HeroService())->get()->toArray();

$hero = (new HeroService())->get();
$this->heroBackgroundMediaId = $hero->background_media_id;
$this->heroBackgroundOptions = \App\Models\Media::latest()->get();
$this->hero = $hero->toArray();


$this->dispatch(

    'notify',

    title: 'Hero Updated'

);
}


/*
|--------------------------------------------------------------------------
| Transformations
|--------------------------------------------------------------------------
*/

public function loadTransformation($id)
{
    $transformation = Transformation::findOrFail($id);

    $this->selectedTransformationId = $transformation->id;

    $this->transformation = $transformation->toArray();
}

public function selectTransformation($id)
{
    $this->loadTransformation($id);
}

public function addTransformation()
{
    $service = new TransformationService();

    $transformation = $service->create();

    $this->transformations = $service->all();

    $this->loadTransformation($transformation->id);

    $this->dispatch(
        'notify',
        title: 'Transformation Created'
    );
}

public function saveTransformation()
{
    $service = new TransformationService();

    $transformation = $service->find(
        $this->selectedTransformationId
    );

    if ($this->beforeImage) {

        $path = $this->beforeImage->store(
            'transformations',
            'public'
        );

        $this->transformation['before_image'] = $path;
    }

    if ($this->afterImage) {

        $path = $this->afterImage->store(
            'transformations',
            'public'
        );

        $this->transformation['after_image'] = $path;
    }

    $this->validate([
        'transformation.name' => 'required|string|max:255',
    ]);

    $service->update(
        $transformation,
        $this->transformation
    );

    $this->transformations = $service->all();

    $this->loadTransformation($transformation->id);

    $this->beforeImage = null;
    $this->afterImage = null;

    $this->dispatch(
        'notify',
        title: 'Transformation Saved'
    );
}

public function deleteTransformation($id)
{
    $service = new TransformationService();

    $transformation = $service->find($id);

    $service->delete($transformation);

    $this->transformations = $service->all();

    if ($this->transformations->count()) {

        $this->loadTransformation(
            $this->transformations->first()->id
        );

    } else {

        $this->transformation = [];

        $this->selectedTransformationId = null;
    }

    $this->dispatch(
        'notify',
        title: 'Transformation Deleted'
    );
}

public function duplicateTransformation($id)
{
    $service = new TransformationService();

    $transformation = $service->find($id);

    $copy = $service->duplicate($transformation);

    $this->transformations = $service->all();

    $this->loadTransformation($copy->id);

    $this->dispatch(
