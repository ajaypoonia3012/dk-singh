        'sort_order' => HomepageCard::max('sort_order') + 1,

        'is_active' => true,

    ]);

    $this->homepageCards =
        HomepageCard::orderBy('sort_order')->get();

    $this->loadHomepageCard($card->id);

    $this->dispatch(
        'notify',
        title: 'Homepage Card Created'
    );
}



public function deleteHomepageCard($id)
{
    $service = new \App\Services\Builder\HomepageCardService();

    $card = $service->find($id);

    $service->delete($card);

    $this->homepageCards = $service->all();

    if ($this->homepageCards->count()) {

        $this->loadHomepageCard(
            $this->homepageCards->first()->id
        );

    } else {

        $this->homepageCard = [];

        $this->selectedHomepageCardId = null;
    }

    $this->dispatch(
        'notify',
        title: 'Homepage Card Deleted'
    );
}


public function toggleHomepageCard($id)
{
    $service = new \App\Services\Builder\HomepageCardService();

    $card = $service->find($id);

    $service->toggle($card);

    $this->homepageCards = $service->all();

    $this->loadHomepageCard($card->id);

    $this->dispatch(
        'notify',
        title: 'Homepage Card Updated'
    );
}

/*
|--------------------------------------------------------------------------
| Programs
|--------------------------------------------------------------------------
*/

public function loadProgram($id)
{
    $program = Program::findOrFail($id);

    $this->selectedProgramId = $program->id;

    $this->program = $program->toArray();
}

public function selectProgram($id)
{
    $this->loadProgram($id);
}

public function addProgram()
{
    $service = new ProgramService();

    $program = $service->create();

    $this->programs = $service->all();

    $this->loadProgram($program->id);

    $this->dispatch(
        'notify',
        title: 'Program Created'
    );
}

public function saveProgram()
{
    $service = new ProgramService();

    $program = $service->find(
        $this->selectedProgramId
    );

    if ($this->programImage) {

        $path = $this->programImage->store(
            'programs',
            'public'
        );

        $this->program['image'] = $path;
    }

$this->validate([
    'program.title' => 'required|string|max:255',
    'program.price' => 'nullable|numeric',
]);

    $service->update(
        $program,
        $this->program
    );

    $this->programs = $service->all();

    $this->loadProgram($program->id);

    $this->programImage = null;

    $this->dispatch(
        'notify',
        title: 'Program Saved'
    );
}

public function deleteProgram($id)
{
    $service = new ProgramService();

    $program = $service->find($id);

    $service->delete($program);

    $this->programs = $service->all();

    if ($this->programs->count()) {

        $this->loadProgram(
            $this->programs->first()->id
        );

    } else {

        $this->program = [];

        $this->selectedProgramId = null;

    }

    $this->dispatch(
        'notify',
        title: 'Program Deleted'
    );
}

public function duplicateProgram($id)
{
    $service = new ProgramService();

    $program = $service->find($id);

    $copy = $service->duplicate($program);

