    /*
    |--------------------------------------------------------------------------
    | Website Sections
    |--------------------------------------------------------------------------
    */

    public function selectSection($id)
    {
        $this->selectedSection =
            $this->sections->firstWhere(
                'id',
                $id
            );
    }

    public function changeDevice($device)
    {
        $this->selectedDevice = $device;
    }

    public function saveSection()
    {
        if (!$this->selectedSection) {
            return;
        }

        $this->selectedSection->save();

        $this->sections =
            WebsiteSection::orderBy('sort_order')->get();
    }

    public function moveUp($id)
    {
        $section = WebsiteSection::find($id);

        if (!$section) {
            return;
        }

        $previous = WebsiteSection::where(
            'sort_order',
            '<',
            $section->sort_order
        )
        ->orderByDesc('sort_order')
        ->first();

        if ($previous) {

            [$section->sort_order, $previous->sort_order] = [
                $previous->sort_order,
                $section->sort_order,
            ];

            $section->save();

            $previous->save();
        }

        $this->sections =
            WebsiteSection::orderBy('sort_order')->get();
    }

    public function moveDown($id)
    {
        $section = WebsiteSection::find($id);

        if (!$section) {
            return;
        }

        $next = WebsiteSection::where(
            'sort_order',
            '>',
            $section->sort_order
        )
        ->orderBy('sort_order')
        ->first();

        if ($next) {

            [$section->sort_order, $next->sort_order] = [
                $next->sort_order,
                $section->sort_order,
            ];

            $section->save();

            $next->save();
        }

        $this->sections =
            WebsiteSection::orderBy('sort_order')->get();
    }

    /*
    |--------------------------------------------------------------------------
    | Render
    |--------------------------------------------------------------------------
    */

    public function render()
    {
        return view(
            'livewire.builder.website-builder'
        );
    }
}
